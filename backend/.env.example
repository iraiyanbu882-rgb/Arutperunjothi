# Copy to .env and supply sandbox credentials from the Cashfree merchant dashboard.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01

# Add Google OAuth credentials in backend/.env only after creating a Google web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults to false. Set true only for private sandbox checkout testing.
DONATIONS_ENABLED=false

# Must be an HTTPS public origin for production. Use the deployed frontend origin locally or in staging.
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./arutperunjothi.db
CORS_ORIGINS=http://localhost:5173

# Both extra gates must be explicitly enabled before live donations.
ENABLE_LIVE_DONATIONS=false
LIVE_DONATION_COMPLIANCE_CONFIRMED=false
